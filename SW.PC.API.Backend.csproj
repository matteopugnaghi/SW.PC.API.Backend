<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RollForward>LatestMinor</RollForward>
    <RuntimeFrameworkVersion>8.0.0</RuntimeFrameworkVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads" Version="6.2.521" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="FluentModbus" Version="5.3.2" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <!-- Pin transitivas a net8 (defensa en profundidad; ahora sin NCalc también protegen
         frente a futuros paquetes que arrastren 9.x). NoWarn="NU1605" suprime el aviso
         de downgrade. APIs de ILogger / ConsoleLogger son compatibles 8.x ↔ 9.x. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" NoWarn="NU1605" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" NoWarn="NU1605" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" NoWarn="NU1605" />
    <!-- Pin restantes transitivas (heredado de la era NCalc; se mantiene como defensa) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.Extensions.Logging.TraceSource" Version="8.0.1" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" NoWarn="NU1605" />
    <!-- NCalcSync eliminado: arrastraba Microsoft.Extensions.Logging.Console 9.0.4
         y causaba FileNotFoundException en publish self-contained net8. Sustituido
         por Services/Smm/FormulaEvaluator.cs (DataTable.Compute, sin deps externas). -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.374.126" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <!-- Excluir carpeta de tests (proyecto separado) -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!-- Excluir Tools (proyectos auxiliares one-shot, no forman parte del backend) -->
  <ItemGroup>
    <Compile Remove="Tools\**" />
    <Content Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="Tools\**" />
  </ItemGroup>

  <!-- Excepción: scripts Kiosk SÍ son runtime (los invoca SystemController) -->
  <ItemGroup>
    <Content Include="Tools\Kiosk\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Excluir carpetas de desarrollo de wwwroot del publish -->
  <ItemGroup>
    <!-- Estos archivos/carpetas se generan en runtime o son solo para desarrollo -->
    <Content Remove="wwwroot\audit\**" />
    <Content Remove="wwwroot\models\**" />
    <Content Remove="wwwroot\sbom\**" />
    <None Remove="wwwroot\audit\**" />
    <None Remove="wwwroot\models\**" />
    <None Remove="wwwroot\sbom\**" />
    <!-- integrity-state.json es específico de cada máquina, no debe ir en publish -->
    <Content Remove="integrity-state.json" />
    <None Remove="integrity-state.json" />
  </ItemGroup>

</Project>
